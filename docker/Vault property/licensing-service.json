{
  "eureka.client.fetchRegistry": "true",
  "eureka.client.registerWithEureka": "true",
  "eureka.client.serviceUrl.defaultZone": "http://eureka-server:8761/eureka/",
  "eureka.instance.instance-id": "${spring.application.name}:${spring.application.instance_id:${random.value}}",
  "eureka.instance.preferIpAddress": "true",
  "logging.level.com.optimagrowth.license": "INFO",
  "logging.level.com.optimagrowth.license.service.LicenseService": "INFO",
  "logging.level.com.optimagrowth.license.service.client.OrganizationCacheService": "DEBUG",
  "logging.level.io.lettuce.core": "WARN",
  "logging.level.org.apache.kafka": "WARN",
  "logging.level.org.hibernate.SQL": "DEBUG",
  "logging.level.org.hibernate.type.descriptor.sql.BasicBinder": "TRACE",
  "logging.level.org.springframework.cloud.stream": "INFO",
  "logging.level.org.springframework.data.redis": "WARN",
  "logging.level.org.springframework.kafka": "INFO",
  "management.endpoints.enabled-by-default": "true",
  "management.endpoints.web.exposure.include": "*",
  "server.port": "8080",
  "spring.cloud.function.definition": "organizationChangeHandler",
  "spring.cloud.loadbalancer.ribbon.enabled": "false",
  "spring.cloud.stream.bindings.organizationChangeHandler-in-0.content-type": "application/json",
  "spring.cloud.stream.bindings.organizationChangeHandler-in-0.destination": "organizationTopic",
  "spring.cloud.stream.bindings.organizationChangeHandler-in-0.group": "license-service",
  "spring.cloud.stream.kafka.binder.auto-create-topics": "true",
  "spring.cloud.stream.kafka.binder.brokers": "kafka:9092",
  "spring.cloud.stream.kafka.binder.consumer-properties.auto.offset.reset": "earliest",
  "spring.cloud.stream.kafka.binder.consumer-properties.enable.auto.commit": "true",
  "spring.cloud.stream.kafka.bindings.organizationChangeHandler-in-0.consumer.auto-commit-offset": "true",
  "spring.cloud.stream.kafka.bindings.organizationChangeHandler-in-0.consumer.start-offset": "earliest",
  "spring.data.redis.host": "redis",
  "spring.data.redis.port": "6379",
  "spring.datasource.driver-class-name": "org.postgresql.Driver",
  "spring.datasource.hikari.connection-test-query": "SELECT 1",
  "spring.datasource.hikari.maximum-pool-size": "10",
  "spring.datasource.hikari.minimum-idle": "2",
  "spring.datasource.hikari.validation-timeout": "3000",
  "spring.datasource.password": "postgres",
  "spring.datasource.url": "jdbc:postgresql://postgres:5432/ostock_dev",
  "spring.datasource.username": "postgres",
  "spring.jpa.database": "POSTGRESQL",
  "spring.jpa.hibernate.ddl-auto": "validate",
  "spring.jpa.hibernate.naming.physical-strategy": "org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl",
  "spring.jpa.properties.hibernate.dialect": "org.hibernate.dialect.PostgreSQLDialect",
  "spring.jpa.show-sql": "true"
}